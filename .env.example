# Copy to .env and fill in values: cp .env.example .env

# FOSSA (https://app.fossa.com/account/settings)
FOSSA_API_TOKEN=
FOSSA_API_BASE=https://app.fossa.com/api

# Mistral API (https://console.mistral.ai)
# Neuro SAN server + client use OPENAI-compatible client pointed at Mistral's API base URL.
MISTRAL_API_KEY=
# run_server.sh and run_poc.sh copy MISTRAL_API_KEY → OPENAI_API_KEY automatically.
OPENAI_API_KEY=

# GitHub (fine-grained PAT: contents + pull_requests on pilot repos)
GITHUB_TOKEN=
GITHUB_ORG=

# POC dry run: skip FOSSA branch verify (saves ~10 min). Set false to require zero security vulns before PR.
# GitHub FOSSA "Security Analysis" must be green; "License Compliance" may still fail (agent may defer licenses).
REMEDIATION_DRY_RUN=false

# false (default): FOSSA fix versions; OSV.dev used only when FOSSA reports NO_SAFE_VERSION.
# true: allow OSV/Maven lookup for any package (not only NO_SAFE_VERSION).
REMEDIATION_OSV_LOOKUP_ENABLED=false

# FOSSA branch verification gate (when REMEDIATION_DRY_RUN=false)
FOSSA_VERIFY_MAX_WAIT_SECONDS=600
FOSSA_VERIFY_POLL_SECONDS=30

# FOSSA CLI uploads branch scans (GitHub integration does not scan arbitrary branches).
# Install locally: brew install fossa — or use Docker image below when Docker is running.
# FOSSA_CLI_DOCKER_IMAGE=fossa/fossa-cli

# Create a new timestamped fix branch from main on each run (recommended for testing)
FOSSA_FRESH_BRANCH=true

# Neuro SAN paths (set automatically by scripts/run_server.sh)
# AGENT_MANIFEST_FILE=
# AGENT_TOOL_PATH=
# AGENT_LLM_INFO_FILE=
# PYTHONPATH=
