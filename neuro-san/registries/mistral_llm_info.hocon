# LLM registry: DeepSeek + Mistral via OpenAI-compatible APIs.
# Credentials: DEEPSEEK_API_KEY / MISTRAL_API_KEY / OPENAI_API_KEY + OPENAI_API_BASE in .env

{
  "default_config": {
    "openai_api_base": "https://api.deepseek.com",
    "temperature": 0.2
  },

  "deepseek-v4-flash": {
    "class": "openai",
    "use_model_name": "deepseek-v4-flash",
    "model_info_url": "https://api-docs.deepseek.com/quick_start/pricing",
    "modalities": {
      "input": ["text"],
      "output": ["text"]
    },
    "capabilities": ["tools"],
    "context_window_size": 1000000,
    "max_output_tokens": 8192,
    "knowledge_cutoff": "unknown"
  },

  "deepseek-v4-pro": {
    "class": "openai",
    "use_model_name": "deepseek-v4-pro",
    "model_info_url": "https://api-docs.deepseek.com/quick_start/pricing",
    "modalities": {
      "input": ["text"],
      "output": ["text"]
    },
    "capabilities": ["tools"],
    "context_window_size": 1000000,
    "max_output_tokens": 8192,
    "knowledge_cutoff": "unknown"
  },

  "deepseek-chat": {
    "class": "openai",
    "use_model_name": "deepseek-chat",
    "model_info_url": "https://api-docs.deepseek.com/quick_start/pricing",
    "modalities": {
      "input": ["text"],
      "output": ["text"]
    },
    "capabilities": ["tools"],
    "context_window_size": 64000,
    "max_output_tokens": 8192,
    "knowledge_cutoff": "unknown"
  },

